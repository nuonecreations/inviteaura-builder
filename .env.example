# InviteAura — optional environment (only needed for Firebase/Supabase mode)
PORT=3000

# Firebase (optional — alternative backend, see README § Firebase/Supabase)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Supabase (optional alternative)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Static-only mode (GitHub Pages / Netlify): no backend needed.
# RSVP/Wishes then save in the guest's browser (localStorage) — use Node backend
# for shared, real-time RSVP storage per couple.
